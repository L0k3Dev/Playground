################################################################################
# Unreal Engine
################################################################################

# Build outputs
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/

# Ignore build outputs inside plugins as well
**/Plugins/*/Binaries/
**/Plugins/*/Intermediate/

# Local build configuration
*.ini.local


################################################################################
# Visual Studio
################################################################################

# User-specific and workspace files
**/.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build database and IntelliSense
*.VC.db
*.VC.VC.opendb
*.ipch

# Compiled object files
*.obj
*.pdb
*.idb
*.ipdb
*.iobj
*.ilk

# Executables and libraries
*.exe
*.dll
*.lib
*.app


################################################################################
# JetBrains Rider / CLion
################################################################################

**/.idea/
*.iws
out/


################################################################################
# Xcode (macOS)
################################################################################

*.xcworkspace
*.xcuserdata/
*.xcuserstate


################################################################################
# Common OS / Editor junk
################################################################################

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Logs and backups
*.log
*.bak
*.tmp
*.swp
*.swo


################################################################################
# Optional: Solution/Project files
################################################################################

# Uncomment these lines if you do not want to track Visual Studio project/solution files
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user